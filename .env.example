# Azure App Service or local environment variables
# Copy this file to .env for local development, or set the values in
# Azure Portal > App Service > Configuration > Application settings.

# Microsoft 365 / Outlook SMTP settings (fallback if Graph API is not configured)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.onmicrosoft.com
SMTP_PASS=your-app-password-or-mailbox-password
EMAIL_FROM=your-email@yourdomain.onmicrosoft.com

# Microsoft Graph API settings (recommended; set these to send via Graph instead of SMTP)
EMAIL_MODE=graph
GRAPH_CLIENT_ID=your-azure-app-client-id
GRAPH_CLIENT_SECRET=your-azure-app-client-secret
GRAPH_TENANT_ID=your-tenant-id-or-domain
GRAPH_SENDER_USER=your-email@tenant.onmicrosoft.com

# Optional app toggles
DRY_RUN=false
FORM_ENABLED=true
DASHBOARD_ENABLED=true

# Optional upload / data paths
UPLOAD_DIR=./public/uploads

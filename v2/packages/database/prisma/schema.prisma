generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}








model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          String    @default("EMPLOYEE")
  managerId     String?
  manager       User?     @relation("ManagerReports", fields: [managerId], references: [id])
  reports       User[]    @relation("ManagerReports")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requestedIssues Issue[] @relation("Requester")
  assignedIssues  Issue[] @relation("Assignee")
  comments      Comment[]
  approvals     Approval[]
}

model Issue {
  id                String       @id @default(cuid())
  ticketId          String       @unique @default(cuid())
  type              String
  title             String
  description       String
  impact            String       @default("MEDIUM")
  category          String       // Hardware/Software/Network/etc
  status            String       @default("SUBMITTED")
  priority          String       @default("PENDING")
  requesterId       String
  requester         User         @relation("Requester", fields: [requesterId], references: [id])
  assigneeId        String?
  assignee          User?        @relation("Assignee", fields: [assigneeId], references: [id])
  customFields      String?      // dynamic form answers stored as JSON
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  comments          Comment[]
  approval          Approval?
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Approval {
  id        String         @id @default(cuid())
  issueId   String         @unique
  issue     Issue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  managerId String
  manager   User           @relation(fields: [managerId], references: [id])
  status    String         @default("PENDING")
  comment   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model CatalogItem {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String
  icon        String?
  category    String
  issueType   String
  formDefId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeArticle {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormDefinition {
  id        String      @id @default(cuid())
  name      String
  issueType String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  fields    FormField[]
}

model FormField {
  id              String    @id @default(cuid())
  formDefinitionId String
  formDefinition  FormDefinition @relation(fields: [formDefinitionId], references: [id], onDelete: Cascade)
  name            String
  key             String
  type            String
  required        Boolean   @default(false)
  options         String?   // SELECT choices stored as JSON
  order           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([formDefinitionId, key])
}
